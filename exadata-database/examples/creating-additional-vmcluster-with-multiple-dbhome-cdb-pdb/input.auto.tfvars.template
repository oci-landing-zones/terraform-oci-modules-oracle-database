#--------------------------------------------------------------------------------------------------------------------------------------
# This example creates an Exadata Cloud Infrastructure and two Cloud VM Clusters on it, with Database Homes, Container Databases (CDBs), and Pluggable Databases (PDBs)
# 1. Copy this template to input.auto.tfvars.
# 2. Provide values for "Tenancy Connectivity Variables".
# 3. Replace <REPLACE-WITH-...> placeholders with appropriate values.
#--------------------------------------------------------------------------------------------------------------------------------------

#---------------------------------------
# Tenancy Connectivity Variables
#---------------------------------------

#tenancy_ocid         = "<REPLACE-WITH-TENANCY-OCID>"  # OCI tenancy OCID.
#user_ocid            = "<REPLACE-WITH-USER-OCID>"  # OCID of the user who registered the API key.
#fingerprint          = "<REPLACE-WITH-FINGERPRINT>"  # Fingerprint of the registered API key.
#private_key_path     = "<REPLACE-WITH-PRIVATE-KEY-PATH>"  # Local path to the matching API signing private key.
#private_key_password = ""  # Passphrase if the private key is encrypted.
#region               = "<REPLACE-WITH-REGION>"  # OCI region identifier.

#---------------------------------------
# Input variable
#---------------------------------------
compartments_dependency = {
  CMP-1 = {
    id = "<REPLACE-WITH-DEFAULT-COMPARTMENT-OCID>"
  }
}

network_dependency = {
  network_security_groups = {
    "NSG-EXA-CLIENT-KEY" = { id = "<REPLACE-WITH-NSG-OCID>" }
    "NSG-EXA-BACKUP-KEY" = { id = "<REPLACE-WITH-NSG-OCID>" }
  }
  subnets = {
    "EXA-SUBNET-KEY-1"        = { id = "<REPLACE-WITH-SUBNET-OCID>" }
    "EXA-BACKUP-SUBNET-KEY-1" = { id = "<REPLACE-WITH-SUBNET-OCID>" }
    "EXA-SUBNET-KEY-2"        = { id = "<REPLACE-WITH-SUBNET-OCID>" }
    "EXA-BACKUP-SUBNET-KEY-2" = { id = "<REPLACE-WITH-SUBNET-OCID>" }
  }
}

secrets_dependency = {
  CDB1-ADMIN-PASSWORD = {
    id = "<REPLACE-WITH-CDB1-ADMIN-PASSWORD-SECRET-OCID>"
  }
  CDB1-TDE-WALLET-PASSWORD = {
    id = "<REPLACE-WITH-CDB1-TDE-WALLET-PASSWORD-SECRET-OCID>"
  }
  CDB2-ADMIN-PASSWORD = {
    id = "<REPLACE-WITH-CDB2-ADMIN-PASSWORD-SECRET-OCID>"
  }
  CDB2-TDE-WALLET-PASSWORD = {
    id = "<REPLACE-WITH-CDB2-TDE-WALLET-PASSWORD-SECRET-OCID>"
  }
}

default_compartment_id = "CMP-1"
default_freeform_tags  = {}
default_defined_tags   = {}

cloud_exadata_infrastructures_configuration = {
  default_maintenance_window = {
    preference     = "NO_PREFERENCE"
    months         = ["JANUARY"]
    weeks_of_month = [2]
    days_of_week   = ["Monday"]
    hours_of_day   = [0, 4]
  }

  cloud_exadata_infrastructures = {
    "My-Exadata-Infra-1" = {
      availability_domain = "<REPLACE-WITH-AVAILABILITY-DOMAIN>"
      display_name = "My-Exadata-Infra-1"
      shape        = "Exadata.X11M"

      compute_count = 2
      storage_count = 3
      customer_contacts = {
        email = "example2@oracle.com"
      }
      database_server_type = "X11M"
      maintenance_window = {
        preference                       = "CUSTOM_PREFERENCE"
        is_custom_action_timeout_enabled = false
        custom_action_timeout_in_mins    = 20
        days_of_week                     = ["MONDAY"]
        hours_of_day                     = [0] # start of a 4-hour UTC slot: 0, 4, 8, 12, 16, or 20
        lead_time_in_weeks               = 2
        months                           = ["FEBRUARY", "MAY", "AUGUST", "NOVEMBER"]
        weeks_of_month                   = [1]
        patching_mode                    = "ROLLING"
      }

      storage_server_type = "X11M-HC"
    }
  }
}

# ----------------------------
# Create Cloud VM Clusters on the Exadata Cloud Infrastructure defined above
# ----------------------------

cloud_vm_clusters_configuration = {
  PROD-EXA1-CL01-KEY = {
    compartment_id            = "CMP-1"
    display_name              = "My-VMCluster-1"
    exadata_infrastructure_id = "My-Exadata-Infra-1"
    db_servers                = ["ALL"] # Select all DB servers in this infrastructure or list individual DB server OCIDs.

    # ---- networking----
    subnet_id        = "EXA-SUBNET-KEY-1"
    backup_subnet_id = "EXA-BACKUP-SUBNET-KEY-1"
    # nsg_ids                = ["NSG-EXA-CLIENT-KEY"]
    # backup_network_nsg_ids = ["NSG-EXA-BACKUP-KEY"]

    # ---- sizing ----
    memory_size_in_gbs          = 60
    db_node_storage_size_in_gbs = 120
    data_storage_size_in_tbs    = 2
    cpu_core_count              = 16

    scan_listener_port_tcp     = 1521
    scan_listener_port_tcp_ssl = 2484

    is_local_backup_enabled     = true
    is_sparse_diskgroup_enabled = true

    # ---- software & identity ----
    gi_version      = "23.0.0.0"
    system_version  = "25.1.6.0.0.250622"
    hostname        = "abc"
    cluster_name    = "clust02"
    ssh_public_keys = ["<REPLACE-WITH-SSH-PUBLIC-KEY>"]
    license_model   = "LICENSE_INCLUDED"

    # ---- optional extras ----
    time_zone = "UTC"

    # ================================
    # Automation update Details
    # ================================
    cloud_automation_update_details = {
      apply_update_time_preference = {
        apply_update_preferred_end_time   = "06:00"
        apply_update_preferred_start_time = "00:00"
      }
      freeze_period = {
        freeze_period_end_time   = "<REPLACE-WITH-FREEZE-END-DATE>"
        freeze_period_start_time = "<REPLACE-WITH-FREEZE-START-DATE>"
      }
      is_early_adoption_enabled = false
      is_freeze_period_enabled  = true
    }

    # Data Collection options
    data_collection_options = {
      is_diagnostics_events_enabled = false
      is_health_monitoring_enabled  = false
      is_incident_logs_enabled      = false
    }

    # file system config
    file_system_configuration_details = {
      "U01" = {
        file_system_size_gb = 20
        mount_point         = "/u01"
      },
      "HOME" = {
        file_system_size_gb = 4
        mount_point         = "/home"
      }
      "VAR" = {
        file_system_size_gb = 5
        mount_point         = "/var"
      }
    }
  }
  PROD-EXA1-CL02-KEY = {
    compartment_id            = "CMP-1"
    display_name              = "My-VMCluster-2"
    exadata_infrastructure_id = "My-Exadata-Infra-1"
    db_servers                = ["ALL"] # Select all DB servers in this infrastructure or list individual DB server OCIDs.

    # ---- networking----
    subnet_id        = "EXA-SUBNET-KEY-2"
    backup_subnet_id = "EXA-BACKUP-SUBNET-KEY-2"
    # nsg_ids                = ["NSG-EXA-CLIENT-KEY"]
    # backup_network_nsg_ids = ["NSG-EXA-BACKUP-KEY"]

    # ---- sizing ----
    memory_size_in_gbs          = 60
    db_node_storage_size_in_gbs = 120
    data_storage_size_in_tbs    = 2
    cpu_core_count              = 16

    scan_listener_port_tcp     = 1521
    scan_listener_port_tcp_ssl = 2484

    is_local_backup_enabled     = true
    is_sparse_diskgroup_enabled = true

    # ---- software & identity ----
    gi_version      = "23.0.0.0"
    system_version  = "25.1.6.0.0.250622"
    hostname        = "abc"
    cluster_name    = "cluster02"
    ssh_public_keys = ["<REPLACE-WITH-SSH-PUBLIC-KEY>"]
    license_model   = "LICENSE_INCLUDED"

    # ---- optional extras ----
    time_zone = "UTC"

    # ================================
    # Automation update Details
    # ================================
    cloud_automation_update_details = {
      apply_update_time_preference = {
        apply_update_preferred_end_time   = "06:00"
        apply_update_preferred_start_time = "00:00"
      }
      freeze_period = {
        freeze_period_end_time   = "<REPLACE-WITH-FREEZE-END-DATE>"
        freeze_period_start_time = "<REPLACE-WITH-FREEZE-START-DATE>"
      }
      is_early_adoption_enabled = false
      is_freeze_period_enabled  = true
    }

    # Data Collection options
    data_collection_options = {
      is_diagnostics_events_enabled = false
      is_health_monitoring_enabled  = false
      is_incident_logs_enabled      = false
    }

    # file system config
    file_system_configuration_details = {
      "U01" = {
        file_system_size_gb = 20
        mount_point         = "/u01"
      },
      "HOME" = {
        file_system_size_gb = 4
        mount_point         = "/home"
      }
      "VAR" = {
        file_system_size_gb = 5
        mount_point         = "/var"
      }
    }
  }
}

cloud_db_homes_configuration = {
  "dbhome1" = {
    # ----------------------------
    # Creating Database Home 
    # ----------------------------
    vm_cluster_id = "PROD-EXA1-CL01-KEY" # can be key from vm_clusters map;  required if source = VM_CLUSTER_NEW
    display_name  = "MyDBHome1"
    db_version    = "19.0.0.0"

    database_software_image_id  = null              # optional custom DB software image
    db_system_id                = null              # optional, only if source = NONE or DB_BACKUP
    enable_database_delete      = false             # optional, default = false
    is_desupported_version      = null              # optional
    is_unified_auditing_enabled = null              # optional
    kms_key_id                  = null              # optional
    kms_key_version_id          = null              # optional
    defined_tags                = {}                # optional
    freeform_tags               = { "env" = "dev" } # optional
  }
  "dbhome2" = {
    # ----------------------------
    # Creating Database Home 
    # ----------------------------
    vm_cluster_id = "PROD-EXA1-CL02-KEY" # can be key from vm_clusters map;  required if source = VM_CLUSTER_NEW
    display_name  = "MyDBHome2"
    db_version    = "19.0.0.0"
    source        = "VM_CLUSTER_NEW" # optional (default = VM_CLUSTER_NEW)

    database_software_image_id  = null              # optional custom DB software image
    db_system_id                = null              # optional, only if source = NONE or DB_BACKUP
    enable_database_delete      = false             # optional, default = false
    is_desupported_version      = null              # optional
    is_unified_auditing_enabled = null              # optional
    kms_key_id                  = null              # optional
    kms_key_version_id          = null              # optional
    defined_tags                = {}                # optional
    freeform_tags               = { "env" = "dev" } # optional
  }
}

# ---------------------------------------
# This is to create Container Database and Pluggable Database
# ---------------------------------------
# The passwords stored in the Vault secrets below must satisfy the module password policy:
# - Length 9-30, at least 2 uppercase, 2 lowercase, 2 digits, 2 special chars from _, #, -
# - Only allowed characters, and must not contain 'oracle' (or reverse), 'sys', 'system', 'metsys'
databases_configuration = {
  CDB1 = {
    source     = "NONE"
    db_home_id = "dbhome1" # References the DB Home defined above (or a DB Home OCID)
    database = {
      admin_password_secret_id = "CDB1-ADMIN-PASSWORD"
      db_name                  = "CDB1"

      character_set = "AL32UTF8"
      db_backup_config = {
        auto_backup_enabled     = "true"
        auto_backup_window      = "SLOT_ONE"
        auto_full_backup_day    = "SUNDAY"
        auto_full_backup_window = "SLOT_TWO"
        backup_deletion_policy  = "DELETE_AFTER_RETENTION_PERIOD"
        recovery_window_in_days   = "35"  # Omit when using a Recovery Service protection policy.
        run_immediate_full_backup = "false"
      }
      db_unique_name = "CDB1_vp_fra"
      db_workload    = "OLTP"
      defined_tags   = {}
      freeform_tags = {}
      ncharacter_set = "AL16UTF16" #The default is AL16UTF16. Allowed values are: AL16UTF16 or UTF8.

      # Create initial PDB during CDB creation
      pdb_name = "PDB1A"
      sid_prefix = "cdb1"
      tde_wallet_password_secret_id = "CDB1-TDE-WALLET-PASSWORD"
    }
  }
  CDB2 = {
    source     = "NONE"
    db_home_id = "dbhome2" # References the DB Home defined above (or a DB Home OCID)
    database = {
      admin_password_secret_id = "CDB2-ADMIN-PASSWORD"
      db_name                  = "CDB2"

      character_set = "AL32UTF8"
      db_backup_config = {
        auto_backup_enabled     = "true"
        auto_backup_window      = "SLOT_ONE"
        auto_full_backup_day    = "SUNDAY"
        auto_full_backup_window = "SLOT_TWO"
        backup_deletion_policy  = "DELETE_AFTER_RETENTION_PERIOD"
        recovery_window_in_days   = "35"  # Omit when using a Recovery Service protection policy.
        run_immediate_full_backup = "false"
      }
      db_unique_name = "CDB2_vp_fra"
      db_workload    = "OLTP"
      defined_tags   = {}
      freeform_tags = {}
      ncharacter_set = "AL16UTF16" #The default is AL16UTF16. Allowed values are: AL16UTF16 or UTF8.

      # Create initial PDB during CDB creation
      pdb_name = "PDB2A"
      sid_prefix = "cdb2"
      tde_wallet_password_secret_id = "CDB2-TDE-WALLET-PASSWORD"
    }
  }
}


